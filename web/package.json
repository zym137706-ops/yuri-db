{
  "name": "yuri-db-web",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 4 website MVP for yuri-db — renders the JSON/YAML dataset with first-class field-level provenance. Works with zero infrastructure (no database required).",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "slim": "node scripts/build-slim.mjs",
    "predev": "npm run slim",
    "dev": "next dev",
    "prebuild": "npm run slim",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run slim && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "verify:contract": "node scripts/assert-data-contract.mjs",
    "verify:imports": "node scripts/verify-imports.mjs",
    "verify:policy": "node scripts/verify-policy.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "verify:anime": "node scripts/verify-anime.mjs",
    "inspect:dataset": "node scripts/inspect-dataset.mjs",
    "verify": "npm run slim && npm run verify:contract && npm run verify:imports && npm run verify:policy && npm run verify:provenance && npm run verify:anime"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
