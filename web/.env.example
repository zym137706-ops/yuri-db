# ---------------------------------------------------------------------------
# yuri-db web (Phase 4 MVP) — environment template
#
# Copy to `.env` (or `.env.local`) only if you need the optional Postgres path.
# The DEFAULT runtime path requires NO environment variables at all: the app
# renders directly from ../data/works.json and ../sources.yaml.
# ---------------------------------------------------------------------------

# Optional. Leave unset (or delete this file) to run on the JSON/YAML path.
# When set, `lib/prisma.ts` can create a client — see README "Future: Postgres".
DATABASE_URL="postgresql://yuri:yuri@localhost:5432/yuri_db?schema=public"

# Optional. Base URL used when the app needs to build absolute links
# (only relevant once the site is deployed).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
